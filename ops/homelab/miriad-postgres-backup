#!/bin/bash
set -euo pipefail
umask 077
exec 9>/run/lock/miriad-postgres-backup.lock
flock -n 9 || exit 0
backup_root=/Storage-2/Backups/miriad-postgres
case "$(findmnt -n -o SOURCE --target /Storage-2/Backups)" in
  Storage-2|Storage-2/*) ;;
  *) echo "Storage-2 is not mounted; refusing backup to the root filesystem" >&2; exit 1 ;;
esac
mkdir -p "$backup_root"
backup_day=$(date -u +%Y%m%dT%H%M%SZ)
backup_tmp=$(mktemp -d "$backup_root/.incomplete.XXXXXX")
trap 'rm -rf -- "$backup_tmp"' EXIT
pct exec 116 -- runuser -u postgres -- pg_dump --format=custom --dbname=miriad_staging > "$backup_tmp/database.dump"
pct exec 116 -- runuser -u postgres -- pg_dumpall --roles-only > "$backup_tmp/roles.sql"
pct exec 116 -- tar -czf - /etc/postgresql/17/main /etc/miriad /etc/cloudflared /etc/systemd/system/cloudflared.service /etc/hosts > "$backup_tmp/configuration.tar.gz"
cp /etc/pve/lxc/116.conf "$backup_tmp/proxmox.conf"
(cd "$backup_tmp" && sha256sum database.dump roles.sql configuration.tar.gz proxmox.conf > SHA256SUMS)
mv "$backup_tmp" "$backup_root/$backup_day"
trap - EXIT
find "$backup_root" -mindepth 1 -maxdepth 1 -type d -name '20*T*Z' -mtime +14 -exec rm -rf -- {} +
printf 'Backup complete: %s\n' "$backup_root/$backup_day"
