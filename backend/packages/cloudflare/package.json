{
  "name": "@miriad/cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "check:bundle": "wrangler deploy --dry-run --outdir dist",
    "migrate": "tsx scripts/migrate.ts",
    "seed:cloudflare": "tsx scripts/seed.ts",
    "test:security": "node scripts/security-smoke.mjs",
    "test:postgres": "tsx scripts/postgres-smoke.ts"
  },
  "dependencies": {
    "@cast/core": "workspace:*",
    "@cast/storage": "workspace:*",
    "@cast/server": "workspace:*",
    "@cast/runtime": "workspace:*",
    "agents": "0.22.0",
    "@cloudflare/sandbox": "0.12.9",
    "hono": "4.11.3",
    "postgres": "3.4.7",
    "zod": "4.4.3",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "wrangler": "4.129.1",
    "@cloudflare/workers-types": "5.20260908.1",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "tsx": "4.21.0"
  }
}
